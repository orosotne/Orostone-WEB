{
  "regions": ["fra1"],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.orostone.sk" }],
      "destination": "https://orostone.sk/$1",
      "permanent": true
    },
    {
      "source": "/((?!favicon.*|apple-touch-icon.*|robots\\.txt).*)",
      "has": [{ "type": "host", "value": "eshop.orostone.sk" }],
      "destination": "https://orostone.sk/$1",
      "permanent": true
    },

    { "source": "/q/OR-NM-:partner",  "destination": "/produkt/nero-margiua?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-NM-:partner",         "permanent": false },
    { "source": "/q/OR-AP-:partner",  "destination": "/produkt/appennino?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-AP-:partner",            "permanent": false },
    { "source": "/q/OR-GG-:partner",  "destination": "/produkt/givenchy-gold?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-GG-:partner",        "permanent": false },
    { "source": "/q/OR-WF-:partner",  "destination": "/produkt/wild-forest?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-WF-:partner",          "permanent": false },
    { "source": "/q/OR-SWE-:partner", "destination": "/produkt/super-white-extra?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-SWE-:partner",   "permanent": false },
    { "source": "/q/OR-AG-:partner",  "destination": "/produkt/astrana-grey?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-AG-:partner",         "permanent": false },
    { "source": "/q/OR-CT-:partner",  "destination": "/produkt/calacatta-top?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-CT-:partner",        "permanent": false },
    { "source": "/q/OR-SD-:partner",  "destination": "/produkt/statuario-diamante?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-SD-:partner",   "permanent": false },
    { "source": "/q/OR-TM-:partner",  "destination": "/produkt/taj-mahal?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-TM-:partner",            "permanent": false },
    { "source": "/q/OR-RT-:partner",  "destination": "/produkt/roman-travertine?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-RT-:partner",     "permanent": false },
    { "source": "/q/OR-GOG-:partner", "destination": "/produkt/gothic-gold?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-GOG-:partner",         "permanent": false },
    { "source": "/q/OR-YW-:partner",  "destination": "/produkt/yabo-white?utm_source=qr&utm_medium=offline_sample&utm_campaign=samples_2026_sk&utm_content=OR-YW-:partner",           "permanent": false },

    { "source": "/kolekcie/:path*", "destination": "/kategoria/sintered-stone", "permanent": true },
    { "source": "/kolekcie", "destination": "/kategoria/sintered-stone", "permanent": true },
    { "source": "/vsetky-produkty", "destination": "/kategoria/sintered-stone", "permanent": true },
    { "source": "/shop", "destination": "/", "permanent": true },
    { "source": "/online-kalkulacka", "destination": "/vzorky", "permanent": true },
    { "source": "/vizualizator", "destination": "/vzorky", "permanent": true },
    { "source": "/key-facts", "destination": "/sinterovany-kamen", "permanent": true },
    { "source": "/o-kameni", "destination": "/sinterovany-kamen", "permanent": true },
    { "source": "/onas", "destination": "/kontakt", "permanent": true },
    { "source": "/contact", "destination": "/kontakt", "permanent": true },
    { "source": "/kamen/bulgari---calacatta-viola", "destination": "/produkt/calacatta-top", "permanent": true },
    { "source": "/kamen/patagonia", "destination": "/produkt/roman-travertine", "permanent": true },
    { "source": "/kamen/pure-black", "destination": "/produkt/nero-margiua", "permanent": true },
    { "source": "/kamen/blue-onyx", "destination": "/produkt/nero-margiua", "permanent": true },
    { "source": "/kamen/dolomit", "destination": "/produkt/appennino", "permanent": true },
    { "source": "/kamen/panda-white", "destination": "/produkt/super-white-extra", "permanent": true },
    { "source": "/kamen/calacatta-bianco", "destination": "/produkt/calacatta-top", "permanent": true },
    { "source": "/kamen/calacatta-gold", "destination": "/produkt/givenchy-gold", "permanent": true },
    { "source": "/kamen/:slug*", "destination": "/kategoria/sintered-stone", "permanent": true },
    { "source": "/blog/technicky-kamen-pracovna-doska", "destination": "/blog/technicky-kamen-cena-pracovna-doska", "permanent": true },
    { "source": "/post/:slug*", "destination": "/blog", "permanent": true },
    { "source": "/blank", "destination": "/", "permanent": true },
    { "source": "/login", "destination": "https://shopify.com/101386420570/account", "permanent": false },
    { "source": "/register", "destination": "https://shopify.com/101386420570/account", "permanent": false },
    { "source": "/ucet", "destination": "https://shopify.com/101386420570/account", "permanent": false },
    { "source": "/objednavky", "destination": "https://shopify.com/101386420570/account", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "eshop.orostone.sk" }],
      "destination": "/robots-noindex.txt"
    },
    { "source": "/sitemap.xml", "destination": "/sitemap-eshop.xml" },
    { "source": "/sitemap-eshop.xml", "destination": "/sitemap-eshop.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/llms.txt", "destination": "/llms.txt" },
    { "source": "/pages-sitemap.xml", "destination": "/sitemap-eshop.xml" },
    { "source": "/sitemap-index.xml", "destination": "/sitemap-eshop.xml" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    {
      "source": "/produkt/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|WhatsApp|TelegramBot|Discordbot|Pinterestbot|vkShare|Viber|Skype|redditbot|Applebot).*"
        }
      ],
      "destination": "/api/product-meta?slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(favicon.ico|favicon-16x16.png|favicon-32x32.png|apple-touch-icon.png|robots.txt|robots-noindex.txt|llms.txt|llms-full.txt|sitemap.xml|sitemap-eshop.xml)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=43200" }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "orostone.sk" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
